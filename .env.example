# 复制为 .env 使用；生产环境不得提交 .env，密钥由部署平台注入
DEMO_MODE=true

# 身份中心（MySQL）
MYSQL_URL=mysql+pymysql://user:password@host:3306/charging_identity

# 业务库（PostgreSQL + pgvector）
POSTGRES_URL=postgresql+psycopg://user:password@host:5432/charging_business

# 缓存/队列（Redis）
REDIS_URL=redis://host:6379/0

# 令牌密钥（生产环境必须使用随机高强度密钥）
JWT_SECRET=change-me-to-a-random-secret

# Agent 模型（DEMO_MODE 下使用内置规则引擎，无需真实密钥）
LLM_MODEL=rule-engine
LLM_API_KEY=
